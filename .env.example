# Copy to .env and fill in values relevant to your own setup. .env is gitignored — per-machine
# config, not shared project content.

# Base URL of the Jenkins instance used by the Jenkins button on session cards (a modal of links:
# the project's job, the session's branch and the same ticket under common prefixes, PR and tag
# views). Leave unset to hide that button entirely.
VITE_JENKINS_BASE_URL=
