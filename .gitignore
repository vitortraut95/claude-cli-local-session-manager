# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Yarn (node-modules linker: only its local install cache lands here)
.yarn/
.pnp.*

# Generated by install-shortcut.sh from the .template — contains this machine's absolute path
claude-session-manager.desktop

# Per-machine preferences for the "New task" modal (default prompt, branch types, worktree-by-default
# checkbox) — local preference, not shared project content.
/userPreferences.json

# Local sidecar data — session nicknames/branches and "New task" branches' recorded bases.
# Per-machine, not shared project content, same reasoning as userPreferences.json above (see
# server/utils/taskStore.ts).
/tasks.json
/tasks.json.*
# Older copies of that data, folded into tasks.json on first start and no longer read.
/custom-titles.json
# Left behind by the removed "Compact & continue" feature — no longer read, still ignored so an
# existing copy doesn't show up as untracked.
/session-continuations.json
/task-base-branches.json
/session-branches.json

# Per-machine env config — see .env.example.
.env

# Kept local only — mentions internal project/infra details not meant for the public repo.
/CLAUDE.md

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/*
